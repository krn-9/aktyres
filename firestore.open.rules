rules_version = '2';

// The rules in use while the app has no login screen. Everything is open to the app EXCEPT
// incomingPayments (the payment notifications): anyone can read them, but only the server
// (the /api/incoming function, using FIREBASE_SERVICE_ACCOUNT) can write them. That stops anyone
// from faking a green "Received" mark by writing to the database directly.
// Paste into Firebase console -> Firestore Database -> Rules -> Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    match /incomingPayments/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /{collection}/{id} {
      allow read, write: if collection != 'incomingPayments';
    }
  }
}
